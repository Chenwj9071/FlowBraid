{
  "name": "flowbraid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "demo:pty": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/demo-pty.ps1",
    "demo:session": "tsx src/cli.ts run examples/agent-session-demo.workflow.yaml --interactive",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  }
}
